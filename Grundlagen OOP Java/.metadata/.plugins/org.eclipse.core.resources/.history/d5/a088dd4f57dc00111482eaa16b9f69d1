public class ArrayBerechnung{
	public static void main(String[] args) {
		int[] arr1 = {5,8,2,15,7,1,22,3,14,9};
		int min1;
		for (int i = 0; i < arr1.length; i++) {
			if (arr1[i] < min1) {
				min1 = arr1[i];
			}
		}
		System.out.println("Array 1:");
		System.out.print(" Minimalwert: "+min1);
		System.out.println();
		
	}
}