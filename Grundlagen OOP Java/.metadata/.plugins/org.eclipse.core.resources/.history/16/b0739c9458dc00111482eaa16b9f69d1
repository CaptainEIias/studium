
public class MinWertMethode {

	public static void main(String[] args) {
		int[] arr1 = {5, 8, 2, 15, 7, 1, 22, 3, 14, 9};
		int min1 = berechneMinimalwert(arr1);
		System.out.println("Minimalwert von arr1: " + min1);
		
		int[] arr2 = {11, 4, 19, 0, 17, 8, 13);
		
	}
	
	public static int berechneMinimalwert(int[] arr) {
		int min = arr[0];
		for (int i = 1; i<arr.length; i++) {
			if(arr[i] < min) {
				min = arr[i];
			}
		}
		return min;
	}

}
