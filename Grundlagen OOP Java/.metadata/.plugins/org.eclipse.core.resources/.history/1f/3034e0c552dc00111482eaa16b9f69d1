public class DurchschnittsTemperatur{
	public static void main(String[] args) {
		int[] temperaturen = {18, 20, 17, 21, 19, 23, 22};
		
		int summe1 = 0;
		for (int i = 0; i<temperaturen.length; i++) {
			summe1 += temperaturen[i];
		}
		double durchschnitt1 = (double) summe1/ temperaturen.length;
		System.out.println("Durchschnitt (for): "+ durchschnitt1);
		
		
	}
}