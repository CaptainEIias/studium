
public class Lampe extends Geraet implements Dimmbar{
	public static final int MAX_HELLIGKEIT = 100;
	private int helligkeit;
	
	public Lampe(String geraetId, String name) {
		super(geraetId, name);
		helligkeit = MAX_HELLIGKEIT;
	}
	
	public int getHelligkeit() {
		return helligkeit;
	}
	
	@Override
	
	@Override
	public String toString() {
		return "Lampe: "+super.toString()+", Helligkeit: "+helligkeit;
	}
	
}
