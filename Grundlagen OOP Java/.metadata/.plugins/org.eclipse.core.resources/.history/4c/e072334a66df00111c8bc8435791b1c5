import java.util.ArrayList;

public class Raum {
	private static final int MAX_GERAETE = 10;
	private String raumId;
	private String name;
	private ArrayList<Geraet> geraete = new ArrayList<Geraet>();
	
	public Raum(String raumId, String name) {
		this.raumId = raumId;
		this.name = name;
	}
	
	public String getName() {
		return name;
	}
	
	
	public void geraetHinzufuegen(Geraet geraet) throws RaumVollException {
		geraete.add(geraet);
	}
	
	public void geraetEntfernen(Geraet geraet) {
		for (int i = 0; i < geraeteAnzahl; i++) {
			if (geraete[i] == geraet) {
				geraete[i] = geraete[geraeteAnzahl -1];
				geraete[geraeteAnzahl - 1] = null;
				geraeteAnzahl--;
				break;
			}
		}
	}
	
	public void geraeteAusschalten() {
		for (int i = 0; i < geraeteAnzahl; i++) {
			geraete[i].ausschalten();
		}
	}
	
	
	public void energieSparen() {
		for (int i = 0; i < geraeteAnzahl; i++) {
			if(geraete[i] instanceof Dimmbar) {
				Dimmbar d = (Dimmbar) geraete[i];
				d.dimmen(20);
			} else {
				geraete[i].ausschalten();
			}
		}
	}
	
	
	
	@Override
	public String toString() {
		String geraete = "";
		for (int i = 0; i < geraeteAnzahl; i++) {
			geraete += "\n\t"+this.geraete[i].toString();
		}
		return "Raum: Raumnummer: "+raumId+", Name: "+name+", "
				+ "Geraeteanzahl: "+geraeteAnzahl+ geraete;
	}
	
	
}
